{
  "name": "QYLAT Inbox - Poller (reads the mailbox, starts the handler once per email)",
  "nodes": [
    {
      "id": "imap",
      "name": "New Email",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "nothing",
        "format": "simple",
        "downloadAttachments": false,
        "options": {
          "customEmailConfig": "[\"UNSEEN\", [\"SINCE\", \"October 10, 2026\"]]",
          "trackLastMessageId": true,
          "forceReconnect": 30
        }
      },
      "credentials": {
        "imap": {
          "id": "IPeKxuNCofVhyQcr",
          "name": "QYLAT mailbox IMAP"
        }
      },
      "notes": "Reads the QYLAT inbox. Leaves every message unread and in place. Attachments are never downloaded. This workflow sends nothing and decides nothing."
    },
    {
      "id": "each",
      "name": "Handle Each Email",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        230,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_HANDLER_ID",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Runs the handler once per email and does not wait for it. A failure in one email cannot stop the others. Duplicates are refused in the database."
    }
  ],
  "connections": {
    "New Email": {
      "main": [
        [
          {
            "node": "Handle Each Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "errorWorkflow": "BFirlikXaAuti0bh",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "active": false
}
